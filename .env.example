# Copie este arquivo para .env para rodar o site no computador.
# No GitHub Actions, os mesmos valores vêm das variáveis do repositório.

# Supabase (ADR-0005): Project Settings → API Keys. Use a chave "publishable" (sb_publishable_…).
# Ela vai no JavaScript que qualquer visitante baixa, e não é segredo: quem protege os dados é a RLS.
# A chave "secret" (sb_secret_…) NUNCA entra aqui, nem em nenhum arquivo do repositório.
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_CHAVE_PUBLICA=sb_publishable_COLE_AQUI

# Só a prévia da V1 (/previa/) ainda lê a planilha publicada (ADR-0003).
VITE_CSV_CATALOGO_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRutIh8zpqo2uSYM0B-pBz2-KRkpUul2onKltBpImqorKxCcRa71Hf6gWwDS3o8VLiPvJlRoUYbpHpg/pub?gid=0&single=true&output=csv
VITE_CSV_CONFIG_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vRutIh8zpqo2uSYM0B-pBz2-KRkpUul2onKltBpImqorKxCcRa71Hf6gWwDS3o8VLiPvJlRoUYbpHpg/pub?gid=1434557142&single=true&output=csv
